{
  "name": "panaderias-backend",
  "version": "1.0.0",
  "description": "Backend Express para el sistema de gestión de la red de panaderías (TP2 ISW3)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --coverage.reportsDirectory=${COVERAGE_DIR:-coverage}"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sentry/node": "^8.40.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.4",
    "vitest": "^5.0.4"
  }
}
