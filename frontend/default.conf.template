server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Compresión básica
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # La dirección del backend y el DNS llegan por variables de entorno: en compose,
    # el nombre del servicio y el DNS interno de Docker; en Render, la URL pública de
    # la api de ESTE entorno y un DNS público. La imagen es la misma en todos los
    # entornos — lo que cambia es la config que Render le inyecta al arrancar.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    # Todo lo que llega a /api/ se reenvía al backend.
    # proxy_pass con variable y SIN barra final: se preserva la URI completa
    # (/api/pedidos -> $backend_api/api/pedidos).
    location /api/ {
        proxy_pass $backend_api;
        proxy_ssl_server_name on;   # si el backend es https (Render), el TLS necesita saber a qué host va
        proxy_http_version 1.1;
        # $host (el Host del pedido original, acá el dominio del FRENTE) rompe en Render:
        # su edge enruta por Host header, y manda la conexión de vuelta al frente -> loop
        # (508 Loop Detected). $proxy_host es el host que sale de $backend_api, el del backend real.
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Assets con hash: cache agresivo
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: cualquier ruta desconocida devuelve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
